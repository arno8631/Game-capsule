# ─────────────────────────────────────────────────────────────
#  CAPSULE · ORTHO INVADERS — configuration
#  Copier ce fichier en .env puis remplir les valeurs.
#  Sans configuration Shopify, le jeu tourne en MODE DÉMO
#  (connexion factice + codes cadeaux fictifs) pour tester.
# ─────────────────────────────────────────────────────────────

PORT=3000
# URL publique HTTPS de la borne (utilisée pour le QR code et le callback OAuth)
PUBLIC_URL=https://arcade.capsule-med.com
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Clé secrète de l'écran : ouvrir la borne avec /screen?key=<SCREEN_KEY>
# (empêche un téléphone de se faire passer pour l'écran et de s'auto-déclarer gagnant)
SCREEN_KEY=change-moi

# ── Connexion client : customer-account | storefront | demo ──
#  customer-account : nouveaux comptes clients Shopify (OAuth, recommandé)
#  storefront       : anciens comptes classiques (email + mot de passe)
#  demo             : prénom + email, sans vérification (tests uniquement)
# ⚠ La boutique Capsule utilise les comptes CLASSIQUES → en production : AUTH_MODE=storefront
AUTH_MODE=demo

# Domaine de la boutique (vitrine) et domaine myshopify (API Admin)
SHOPIFY_STORE_DOMAIN=capsule-med.com
SHOPIFY_ADMIN_DOMAIN=xxxxx.myshopify.com
SHOPIFY_API_VERSION=2026-07

# AUTH_MODE=customer-account → canal « Headless » > Customer Account API
CUSTOMER_ACCOUNT_CLIENT_ID=
CUSTOMER_ACCOUNT_CLIENT_SECRET=

# AUTH_MODE=storefront → jeton public Storefront API
STOREFRONT_ACCESS_TOKEN=

# ── API Admin (création des codes cadeaux + tag client) ──
# Soit un jeton direct (shpat_...), soit client_id/secret d'une app du Dev Dashboard.
# Scopes : read_customers, write_customers, read_discounts, write_discounts, read_products
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

# ── Lots ──
# Nombre maximum de replays offerts pendant l'événement (tous lots confondus)
MAX_PRIZES=30
# Validité des codes (jours)
REWARD_VALIDITY_DAYS=60
# Tag ajouté au client gagnant (un seul gain par compte)
WINNER_TAG=arcade-ortho-2026-gagnant
# Durée minimale d'une partie gagnante (secondes) — anti-triche
MIN_WIN_SECONDS=45

# Tags posés sur chaque praticien qui joue (retrouvables dans Shopify > Clients)
# + jeuJO-inscrit pour les comptes créés via le jeu, + la profession choisie
PLAYER_TAGS=jeuJO,jeuJO-2026
# Domaines autorisés à intégrer le jeu (page capsule-med.com/pages/ortho-invaders)
STORE_ORIGINS=https://capsule-med.com,https://www.capsule-med.com
